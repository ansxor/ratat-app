# HTTP port for the Hatk server and SvelteKit frontend
PORT=3000

# SQLite database file path (relative to project root, or absolute path in production)
DATABASE=data/hatk.db

# Public Bluesky AppView URL used for live fallback reads and actor search
BSKY_APPVIEW_URL=https://public.api.bsky.app

# Jetstream WebSocket endpoint for the optional global like-count tail worker
JETSTREAM_URL=wss://jetstream1.us-east.bsky.network

# Enable mirroring global like counts into ratat_like_count (set false to disable)
JETSTREAM_LIKE_TAIL=true
