# Copy to .env and Bun expands ${...} from the mise-exported environment.
# Run `mise env` to inspect the computed values.
DATABASE_URL=postgres://ratat:ratat@localhost:${RATAT_POSTGRES_PORT}/ratat

# apps/xrpc-server
PORT=${RATAT_API_PORT}
HOST=127.0.0.1
BSKY_APPVIEW_URL=https://public.api.bsky.app

# apps/web — dev must be reached over 127.0.0.1 for the loopback OAuth client
VITE_RATAT_APPVIEW_URL=http://127.0.0.1:${RATAT_API_PORT}
VITE_ATPROTO_HANDLE_RESOLVER_URL=https://public.api.bsky.app
VITE_ATPROTO_PLC_URL=https://plc.directory
