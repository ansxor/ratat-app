{
  "lexicon": 1,
  "id": "net.ratat.actor.searchActorsTypeahead",
  "defs": {
    "main": {
      "type": "query",
      "description": "As-you-type actor suggestions, proxied straight to app.bsky.actor.searchActorsTypeahead. Ratat holds no actor search of its own — everyone on Bluesky is findable, whether or not Ratat has indexed them. [public]",
      "parameters": {
        "type": "params",
        "required": ["q"],
        "properties": {
          "q": {
            "type": "string",
            "description": "Search term, matched against handle and name."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["actors"],
          "properties": {
            "actors": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.ratat.actor.defs#profileViewBasic"
              }
            }
          }
        }
      }
    }
  }
}
