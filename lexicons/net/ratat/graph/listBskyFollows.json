{
  "lexicon": 1,
  "id": "net.ratat.graph.listBskyFollows",
  "defs": {
    "main": {
      "type": "query",
      "description": "List an actor's Bluesky follows (app.bsky.graph.follow) hydrated as basic profiles for Ratat onboarding.",
      "parameters": {
        "type": "params",
        "properties": {
          "actor": {
            "type": "string",
            "description": "DID or handle; defaults to the signed-in viewer.",
            "format": "at-identifier"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor from a previous page; omit for the first page."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["follows"],
          "properties": {
            "follows": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.ratat.actor.defs#profileViewBasic"
              }
            },
            "cursor": {
              "type": "string",
              "description": "Absent when the last page has been served."
            }
          }
        }
      },
      "errors": [
        {
          "name": "ProfileNotFound"
        }
      ]
    }
  }
}
