{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    ".beads/**",
    "**/dist/**",
    "**/.output/**",
    "**/.tanstack/**",
    "**/routeTree.gen.ts",
    "packages/db/drizzle/**",
    "packages/lexicon/lexicons/**"
  ],
  "rules": {},
  "env": {
    "builtin": true
  }
}
