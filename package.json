{
  "name": "ratat-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:web": "bun --filter '@ratat/web' dev",
    "dev:server": "bun --filter '@ratat/xrpc-server' dev",
    "dev:ingester": "bun --filter '@ratat/ingester' dev",
    "build": "bun --filter '@ratat/web' build",
    "migrate": "bun --filter '@ratat/db' migrate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:colors": "bun --filter '@ratat/web' lint:colors",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun --filter '*' typecheck && tsc --noEmit",
    "test": "bun --filter '*' test",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "railway": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
